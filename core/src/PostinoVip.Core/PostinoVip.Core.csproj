<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testi delle mail per lingua (tappa «Lingua», L6b): PostinoVip.Core.Texts.<lingua>.json -->
    <EmbeddedResource Include="Texts\*.json" LogicalName="PostinoVip.Core.Texts.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test del FETCH IMAP vero (ImportanceTests) con ImapFolderSource, che è interna. -->
    <InternalsVisibleTo Include="PostinoVip.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Ical.Net" Version="5.2.4" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="NodaTime" Version="3.3.7" />
  </ItemGroup>

</Project>
